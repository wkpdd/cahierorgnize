{
  "name": "cahierorganize",
  "version": "0.1.0",
  "private": true,
  "description": "Tender & public procurement manager for Algerian suppliers (cahier des charges, consultations, bons de commande, marchés)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning server/dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.77.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
